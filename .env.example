# Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/PeopleHub?schema=public"

# Application Config
PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NODE_ENV="development"

# Security & Authentication
JWT_SECRET="super-secret-jwt-access-key-change-in-production"
JWT_REFRESH_SECRET="super-secret-jwt-refresh-key-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Redis & BullMQ
REDIS_URL="redis://localhost:6379"

# S3 Compatible File Storage
S3_ENDPOINT="localhost"
S3_PORT=9000
S3_ACCESS_KEY="minio_access_key"
S3_SECRET_KEY="minio_secret_key"
S3_BUCKET_NAME="people-hub-documents"
S3_USE_SSL="false"

# Monitoring
SENTRY_DSN=""
OPENTELEMETRY_SERVICE_NAME="people-hub-api"
OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT="http://localhost:4317"
